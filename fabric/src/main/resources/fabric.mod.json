{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "sources": "https://github.com/LuckyOwlStudios/kingdom"
  },
  "license": "${license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.luckyowlstudios.kingdoms.KingdomsFabric"
    ],
    "client": [
      "com.luckyowlstudios.kingdoms.KingdomsFabricClient"
    ],
    "fabric-gametest": [
      "com.luckyowlstudios.kingdoms.test.KingdomsGameTests",
      "com.luckyowlstudios.kingdoms.test.DiplomacyGameTests",
      "com.luckyowlstudios.kingdoms.test.WatchtowerGameTests"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}"
  }
}
